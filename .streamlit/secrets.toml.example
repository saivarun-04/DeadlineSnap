# Copy this file to .streamlit/secrets.toml and fill in your actual values
# NEVER commit real secrets to git!

# Gemini API key - get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY = "your_gemini_api_key_here"

# Gmail address for sending emails
GMAIL_ADDRESS = "your_email@gmail.com"

# Gmail App Password - create at https://myaccount.google.com/apppasswords
# (16 characters long, NOT your regular password)
GMAIL_APP_PASSWORD = "your_16_character_app_password_here"